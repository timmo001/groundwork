{
  "name": "@timmo001/groundwork-ui",
  "version": "0.8.0",
  "description": "Groundwork's framework-free web components, styled by the --gw-* tokens",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "custom-elements.json",
    "README.md",
    "LICENSE"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": true,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/groundwork.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check",
    "lint": "oxlint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "bun run scripts/manifest.ts",
    "gen:check": "bun run scripts/manifest.ts --check"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@oxlint/plugins": "1.90.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
