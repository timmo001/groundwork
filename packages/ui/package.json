{
  "name": "@timmo001/groundwork-ui",
  "version": "0.21.0",
  "description": "Groundwork's framework-free web components, styled by the --gw-* tokens",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./custom-elements.json": "./custom-elements.json",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "custom-elements.json",
    "README.md",
    "LICENSE"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": [
    "./src/index.ts",
    "./src/define/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/groundwork.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check",
    "lint": "oxlint .",
    "typecheck": "tsc && tsc -p scripts && bun run scripts/typecheck-alone.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "bun run scripts/manifest.ts && bun run scripts/composition.ts",
    "gen:check": "bun run scripts/manifest.ts --check && bun run scripts/composition.ts --check"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@oxlint/plugins": "1.92.0",
    "@timmo001/oxlint-rules": "0.6.5",
    "@types/bun": "1.4.4",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tanstack/table-core": "9.3.1",
    "@tanstack/virtual-core": "3.19.11",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0"
  }
}
