{
  "name": "@timmo001/groundwork-pwa",
  "version": "0.33.0",
  "description": "Groundwork's installable web app pieces: the manifest and icons from the theme, the service worker, Web Push and pairing contracts",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/config.ts",
    "./build": "./src/build.ts",
    "./pairing": "./src/pairing.ts",
    "./push": "./src/push.ts",
    "./view": "./src/view.ts",
    "./worker": "./src/worker.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/groundwork.git",
    "directory": "packages/pwa"
  },
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check",
    "test": "bun test",
    "lint": "oxlint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@timmo001/groundwork-tokens": "0.33.0",
    "effect": "4.1.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@timmo001/oxlint-rules": "0.6.5",
    "@types/bun": "1.4.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
