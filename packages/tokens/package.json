{
  "name": "@timmo001/groundwork-tokens",
  "version": "0.9.23",
  "description": "Groundwork's design tokens: the theme schema, the OKLCH solver and every theme as CSS and JSON",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./page": "./src/page.ts",
    "./webmcp": "./src/webmcp.ts",
    "./opentui": "./generated/opentui.ts",
    "./themes.css": "./generated/themes.css",
    "./themes.json": "./generated/themes.json",
    "./themes/*.json": "./themes/*.json"
  },
  "files": [
    "src",
    "!src/cli.ts",
    "themes",
    "generated",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/groundwork.git",
    "directory": "packages/tokens"
  },
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check",
    "gen": "bun run src/cli.ts gen",
    "gen:check": "bun run src/cli.ts gen --check",
    "contrast": "bun run src/cli.ts contrast",
    "lint": "oxlint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@types/culori": "4.0.1",
    "culori": "4.0.2",
    "effect": "4.1.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@oxlint/plugins": "1.90.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "1.4.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
