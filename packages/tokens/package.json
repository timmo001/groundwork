{
  "name": "@timmo001/groundwork-tokens",
  "version": "0.33.0",
  "description": "Groundwork's design tokens: the theme schema, the OKLCH solver and every theme as CSS and JSON",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./build": "./src/build.ts",
    "./choices": "./src/choices.ts",
    "./page": "./src/page.ts",
    "./webmcp": "./src/webmcp.ts",
    "./omarchy-current": "./src/omarchy-current.ts",
    "./desktop-themes": "./src/desktop-themes.ts",
    "./translate": "./src/translate.ts",
    "./opentui": "./generated/opentui.ts",
    "./themes.css": "./generated/themes.css",
    "./themes.json": "./generated/themes.json",
    "./themes/*.json": "./themes/*.json"
  },
  "bin": {
    "groundwork-tokens": "./src/bin.ts"
  },
  "files": [
    "src",
    "!src/cli.ts",
    "themes",
    "generated",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/groundwork.git",
    "directory": "packages/tokens"
  },
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check",
    "gen": "bun run src/cli.ts gen",
    "gen:check": "bun run src/cli.ts gen --check",
    "contrast": "bun run src/cli.ts contrast",
    "lint": "oxlint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@types/culori": "4.0.1",
    "culori": "4.0.2",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@timmo001/oxlint-rules": "0.6.5",
    "@types/bun": "1.4.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
