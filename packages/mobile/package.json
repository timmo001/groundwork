{
  "name": "@timmo001/groundwork-mobile",
  "version": "0.20.0",
  "description": "The page side of Groundwork's Android shell: the app config, the typed bridge to the shell, and a fallback to the PWA outside it",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/config.ts",
    "./bridge": "./src/bridge.ts",
    "./view": "./src/view.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/groundwork.git",
    "directory": "packages/mobile"
  },
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check",
    "test": "bun test",
    "lint": "oxlint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@timmo001/groundwork-pwa": "0.20.0",
    "@timmo001/groundwork-tokens": "0.20.0",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.92.0",
    "@timmo001/oxlint-rules": "0.6.4",
    "@types/bun": "1.4.4",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
