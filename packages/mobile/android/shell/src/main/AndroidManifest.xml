<?xml version="1.0" encoding="utf-8"?>
<!--
  What every shell needs: the internet, notifications, Live Updates and the
  push service. The app's own manifest declares its activity with its deep
  link and share intent filters, any tiles, and the camera or microphone
  permissions it wants the page to have.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

  <application>
    <service
      android:name="dev.timmo.groundwork.shell.ShellPushService"
      android:exported="false">
      <intent-filter>
        <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
