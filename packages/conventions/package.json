{
  "name": "@timmo001/groundwork-conventions",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./conventions.json": "./generated/conventions.json"
  },
  "scripts": {
    "check": "bun run src/cli.ts check",
    "gen": "bun run src/cli.ts gen",
    "gen:check": "bun run src/cli.ts gen --check",
    "lint": "oxlint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@timmo001/groundwork-tokens": "workspace:*",
    "effect": "4.1.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "1.4.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
