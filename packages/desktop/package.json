{
  "name": "@timmo001/groundwork-desktop",
  "version": "0.28.0",
  "description": "Groundwork's desktop defaults for Electrobun apps: the tray, find, zoom, the right-click menu, one instance, the system's mode and scale, and running in the tray",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/config.ts",
    "./main": "./src/main.ts",
    "./view": "./src/view.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/groundwork.git",
    "directory": "packages/desktop"
  },
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check",
    "test": "bun test",
    "lint": "oxlint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@timmo001/groundwork-tokens": "0.28.0",
    "@timmo001/groundwork-ui": "0.28.0",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@timmo001/oxlint-rules": "0.6.5",
    "@types/bun": "1.4.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
