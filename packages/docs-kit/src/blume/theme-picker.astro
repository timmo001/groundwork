---
/**
 * Picks the colour mode, Darker included, and optionally the Groundwork
 * theme. Blume's own toggle still switches light and dark; this keeps in step
 * with it. Theme choices need `@timmo001/docs-kit/blume/themes/all.css`.
 */
interface Props {
  /** Themes to offer, in order. Leave out to offer the mode only. */
  themes?: readonly { id: string; name: string }[];
  /** The theme the site's own `theme.css` imports, shown when none is picked. */
  defaultTheme?: string;
}

const { themes = [], defaultTheme = "base" } = Astro.props;
---

<script is:inline>
  (() => {
    const root = document.documentElement;

    const read = (key) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const apply = () => {
      const theme = read("gw-docs-theme");

      if (theme) root.dataset.gwDocsTheme = theme;
      else delete root.dataset.gwDocsTheme;

      if (read("gw-darker") === "1" && root.dataset.theme === "dark") {
        root.setAttribute("data-gw-darker", "");
      } else {
        root.removeAttribute("data-gw-darker");
      }
    };

    apply();
    document.addEventListener("astro:after-swap", apply);
  })();
</script>

<div class="gw-theme-picker" data-gw-theme-picker data-default-theme={defaultTheme}>
  {
    themes.length > 0 && (
      <label>
        <span class="gw-visually-hidden">Theme</span>
        <select data-gw-theme-select>
          {themes.map((theme) => (
            <option value={theme.id}>{theme.name}</option>
          ))}
        </select>
      </label>
    )
  }
  <label>
    <span class="gw-visually-hidden">Colour mode</span>
    <select data-gw-mode-select>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
      <option value="darker">Darker</option>
    </select>
  </label>
</div>

<script>
  const root = document.documentElement;

  const save = (key: string, value: string | null) => {
    try {
      if (value === null) localStorage.removeItem(key);
      else localStorage.setItem(key, value);
    } catch {
      // Storage can be blocked; the choice then lasts for the page.
    }
  };

  const currentMode = () =>
    root.dataset.theme !== "dark"
      ? "light"
      : root.hasAttribute("data-gw-darker")
        ? "darker"
        : "dark";

  const sync = () => {
    for (const picker of document.querySelectorAll("div[data-gw-theme-picker]")) {
      if (!(picker instanceof HTMLElement)) continue;

      const mode = picker.querySelector("select[data-gw-mode-select]");
      const theme = picker.querySelector("select[data-gw-theme-select]");

      if (mode) mode.value = currentMode();

      if (theme) theme.value = root.dataset.gwDocsTheme ?? picker.dataset.defaultTheme ?? "";
    }
  };

  document.addEventListener("change", (event) => {
    const target = event.target;

    if (!(target instanceof HTMLSelectElement)) return;

    if (target.matches("[data-gw-mode-select]")) {
      const dark = target.value !== "light";

      root.dataset.theme = dark ? "dark" : "light";
      root.toggleAttribute("data-gw-darker", target.value === "darker");
      save("blume-theme", dark ? "dark" : "light");
      save("gw-darker", target.value === "darker" ? "1" : null);
    }

    if (target.matches("[data-gw-theme-select]")) {
      root.dataset.gwDocsTheme = target.value;
      save("gw-docs-theme", target.value);
    }
  });

  // Blume's toggle flips data-theme; going light ends Darker.
  new MutationObserver(() => {
    if (root.dataset.theme !== "dark" && root.hasAttribute("data-gw-darker")) {
      root.removeAttribute("data-gw-darker");
      save("gw-darker", null);
    }

    sync();
  }).observe(root, {
    attributes: true,
    attributeFilter: ["data-theme", "data-gw-darker", "data-gw-docs-theme"],
  });

  sync();

  document.addEventListener("astro:after-swap", sync);
</script>

<style>
  .gw-theme-picker {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
  }

  .gw-theme-picker select {
    height: 2.25rem;
    padding: 0 0.5rem;
    border: 1px solid var(--blume-border);
    border-radius: calc(var(--blume-radius) * 0.6);
    background: var(--blume-background);
    color: var(--blume-foreground);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .gw-theme-picker select:hover {
    background: var(--blume-muted);
  }

  .gw-theme-picker select:focus-visible {
    outline: 2px solid var(--blume-accent);
    outline-offset: 2px;
  }

  .gw-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
