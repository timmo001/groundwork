---
import Search from "blume/components/layout/Search.astro";
import { SOCIAL_ICONS } from "blume/components/layout/footer-socials.ts";
import data from "blume:data";
import ThemePicker from "./theme-picker.astro";

/**
 * `themes`, `group`, `defaultTheme` and the picker's labels (`label`,
 * `modeLabel`, `modeLabels`, `unavailableHint`) go to the theme picker, and
 * `githubLabel` names the GitHub link, `GitHub repository` by default;
 * everything else Blume passes goes to its search.
 */
const {
  themes,
  group,
  defaultTheme,
  label,
  modeLabel,
  modeLabels,
  unavailableHint,
  githubLabel = "GitHub repository",
  ...searchProps
} = Astro.props;

const repoUrl = data.config.repoUrl;

const github = SOCIAL_ICONS.github;
---

<Search {...searchProps} />
<ThemePicker
  themes={themes}
  group={group}
  defaultTheme={defaultTheme}
  label={label}
  modeLabel={modeLabel}
  modeLabels={modeLabels}
  unavailableHint={unavailableHint}
/>
{
  repoUrl && (
    <a
      aria-label={githubLabel}
      class="header-github"
      data-blume-tooltip={githubLabel}
      href={repoUrl}
      rel="noreferrer"
      target="_blank"
    >
      <svg aria-hidden="true" fill="currentColor" height="18" viewBox="0 0 24 24" width="18">
        <path d={github.path} />
      </svg>
    </a>
  )
}

<style>
  .header-github {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    color: var(--color-muted-foreground);
    transition-property: color, background-color;
    transition-duration: 150ms;
  }

  .header-github:hover {
    background-color: var(--color-muted);
    color: var(--color-foreground);
  }
</style>
