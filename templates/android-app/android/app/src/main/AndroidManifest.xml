<?xml version="1.0" encoding="utf-8"?>
<!--
  The demo's manifest: its activity with the share and deep link intent
  filters and the sharing shortcuts' share target, a quick settings tile, the camera for the page and the QR
  scanner, and the local network, which Android 17 gates for apps that
  target it. The shell's own manifest adds the internet, notifications, the
  push service and the scanner.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

  <application
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Groundwork.Shell">
    <meta-data android:name="groundwork.devUrl" android:value="${devUrl}" />

    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
      android:exported="true"
      android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="groundwork-demo" />
      </intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
    </activity>

    <service
      android:name="dev.timmo.groundwork.shell.ShellTileService"
      android:exported="true"
      android:icon="@drawable/ic_mark"
      android:label="@string/tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data android:name="groundwork.tileLink" android:value="groundwork-demo://#phone" />
    </service>
  </application>
</manifest>
