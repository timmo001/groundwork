{
  "name": "desktop-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electrobun dev --watch",
    "start": "electrobun dev",
    "build": "electrobun build --env=stable",
    "lint": "electrobun prepare && oxlint .",
    "typecheck": "electrobun prepare && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@timmo001/groundwork-demo": "workspace:*",
    "@timmo001/groundwork-desktop": "workspace:*",
    "@timmo001/groundwork-tokens": "workspace:*",
    "@timmo001/groundwork-ui": "workspace:*"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@timmo001/oxlint-rules": "0.6.5",
    "@types/bun": "1.4.4",
    "electrobun": "2.0.6",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
