    "fuse.js": "7.3.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "1.4.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
