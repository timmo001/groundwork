{
  "name": "groundwork-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun scripts/report.ts && blume dev",
    "start": "bun scripts/report.ts && blume dev",
    "build": "bun scripts/report.ts && blume build --strict",
    "check": "blume check --strict",
    "lint": "oxlint .",
    "validate": "blume validate --strict",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:preview": "wrangler versions upload --config dist/server/wrangler.json",
    "preview": "blume preview",
    "brand": "bun scripts/brand-images.ts",
    "capture": "bun scripts/capture.ts",
    "report": "bun scripts/report.ts",
    "test:visual": "bun scripts/report.ts && blume build --strict --isolated && playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@fontsource-variable/albert-sans": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@timmo001/groundwork-conventions": "workspace:*",
    "@timmo001/groundwork-demo": "workspace:*",
    "@timmo001/groundwork-report": "workspace:*",
    "@timmo001/groundwork-tokens": "workspace:*",
    "@timmo001/groundwork-ui": "workspace:*",
    "@timmo001/docs-kit": "workspace:*",
    "blume": "2.2.7",
    "effect": "4.1.3",
    "lit": "3.3.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@playwright/test": "1.65.0",
    "@timmo001/oxlint-rules": "0.6.5",
    "@types/bun": "1.4.4",
    "astro": "7.4.8",
    "axe-core": "4.14.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.65.0",
    "wrangler": "4.159.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
