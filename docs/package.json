{
  "name": "groundwork-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun scripts/report.ts && blume dev",
    "start": "bun scripts/report.ts && blume dev",
    "build": "bun scripts/report.ts && blume build --strict",
    "check": "blume check --strict",
    "lint": "oxlint .",
    "validate": "blume validate --strict",
    "deploy": "alchemy deploy --stage prod --yes",
    "deploy:github": "alchemy deploy --config stacks/github.ts --stage prod --yes",
    "plan": "alchemy plan --stage prod",
    "preview": "blume preview",
    "brand": "bun scripts/brand-images.ts",
    "capture": "bun scripts/capture.ts",
    "report": "bun scripts/report.ts",
    "test:visual": "bun scripts/report.ts && blume build --strict --isolated && playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@fontsource-variable/albert-sans": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@timmo001/docs-kit": "workspace:*",
    "@timmo001/groundwork-conventions": "workspace:*",
    "@timmo001/groundwork-demo": "workspace:*",
    "@timmo001/groundwork-report": "workspace:*",
    "@timmo001/groundwork-tokens": "workspace:*",
    "@timmo001/groundwork-ui": "workspace:*",
    "blume": "2.2.7",
    "effect": "4.1.5",
    "lit": "3.3.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/github": "2.0.0-beta.87",
    "@effect/platform-bun": "4.1.5",
    "@emnapi/runtime": "1.11.3",
    "@oxlint/plugins": "1.94.0",
    "@playwright/test": "1.65.1",
    "@timmo001/oxlint-rules": "0.7.1",
    "@types/bun": "1.4.5",
    "alchemy": "2.0.0-beta.87",
    "astro": "7.4.13",
    "axe-core": "4.14.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "1.65.1",
    "wrangler": "4.166.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
