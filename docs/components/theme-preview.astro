---
/**
 * `<ThemePreview>`: a mock panel in each of a theme's modes, showing its
 * surfaces, text, accent and status colors together.
 */
import tokens from "@groundwork/tokens/themes.json";

interface Props {
  theme: string;
  /** Show only these modes, such as ["dark"]. Defaults to every mode the theme has. */
  modes?: string[];
  compact?: boolean;
}

const { theme: id, modes: only, compact = false } = Astro.props;
const theme = tokens.themes.find((item) => item.id === id);

if (theme === undefined) throw new Error(`Unknown theme: ${id}`);

const labels: Record<string, string> = {
  light: "Light",
  dark: "Dark",
  darker: "Darker",
};

const modes = Object.keys(theme.modes).filter(
  (mode) => only === undefined || only.includes(mode),
);

const statuses = [
  ["info", "Note", "Sync runs every hour."],
  ["success", "Tip", "All 12 checks passed."],
  ["important", "Important", "Two decisions wait on you."],
  ["warning", "Warning", "The token expires in 2 days."],
  ["danger", "Caution", "This removes the backup."],
] as const;
---

<div class:list={["previews", { compact }]}>
  {
    modes.map((mode) => (
      <section
        aria-label={`${theme.name}, ${labels[mode] ?? mode}`}
        class="preview"
        data-gw-mode={mode}
        data-gw-theme={theme.id}
      >
        <header class="bar">
          <span class="title">{theme.name}</span>
          <span class="mode">{labels[mode] ?? mode}</span>
        </header>
        <div class="body">
          <div class="panel">
            <p class="label">Overview</p>
            <h3 class="heading">Machine controls</h3>
            <p class="primary">
              Next boot is set to <a href="#top">Arch Linux</a>, with the VM test
              bed on standby.
            </p>
            <p class="secondary">Updated 4 minutes ago</p>
            <div class="row">
              <gw-button>Reboot</gw-button>
              <gw-button appearance="filled">Plan boot</gw-button>
              <gw-button variant="neutral" appearance="outlined">
                Cancel
              </gw-button>
            </div>
          </div>
          {!compact && (
            <>
              <gw-input label="Hostname" value="workshop" />
              <div class="row">
                <gw-chip>Linux</gw-chip>
                <gw-chip tone="accent">Windows</gw-chip>
                <gw-chip>Installer</gw-chip>
              </div>
              <div class="alerts">
                {statuses.map(([status, title, text]) => (
                  <gw-alert tone={status} heading={title}>
                    {text}
                  </gw-alert>
                ))}
              </div>
              <table class="rows">
                <tbody>
                  <tr>
                    <td>dotfiles</td>
                    <td class="figure">14</td>
                    <td>
                      <gw-chip tone="success">Passing</gw-chip>
                    </td>
                  </tr>
                  <tr>
                    <td>system-bridge</td>
                    <td class="figure">3</td>
                    <td>
                      <gw-chip tone="warning">Waiting</gw-chip>
                    </td>
                  </tr>
                  <tr>
                    <td>triage</td>
                    <td class="figure">1</td>
                    <td>
                      <gw-chip tone="danger">Failing</gw-chip>
                    </td>
                  </tr>
                </tbody>
              </table>
            </>
          )}
        </div>
      </section>
    ))
  }
</div>

<style>
  .previews {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .preview {
    overflow: hidden;
    font-family: var(--gw-font-sans);
    font-size: var(--gw-font-size-s);
    font-weight: var(--gw-font-weight-regular);
    line-height: 1.5;
    color: var(--gw-color-text-primary);
    background: var(--gw-color-surface-default);
    border: 1px solid var(--gw-color-border-normal);
    border-radius: var(--gw-radius-panel);
    box-shadow: var(--gw-shadow-m);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--gw-space-2) var(--gw-space-4);
    background: var(--gw-color-surface-lower);
    border-bottom: 1px solid var(--gw-color-border-quiet);
  }

  .title {
    font-weight: var(--gw-font-weight-strong);
    color: var(--gw-color-text-strong);
  }

  .mode,
  .label {
    font-size: var(--gw-font-size-xs);
    color: var(--gw-color-text-secondary);
    text-transform: var(--gw-label-transform);
    letter-spacing: var(--gw-label-tracking);
  }

  .label {
    display: block;
    margin: 0 0 var(--gw-space-1);
    font-weight: var(--gw-font-weight-strong);
  }

  .body {
    display: grid;
    gap: var(--gw-space-4);
    padding: var(--gw-space-4);
  }

  .panel {
    position: relative;
    padding: var(--gw-space-4);
    padding-inline-start: calc(var(--gw-space-4) + var(--gw-panel-marker));
    background-color: var(--gw-color-surface-raised);
    background-image: var(--gw-panel-sheen);
    border: var(--gw-border-width) solid var(--gw-border-color);
    border-top: max(var(--gw-border-width), var(--gw-panel-flange)) solid
      var(--gw-panel-flange-color);
    border-radius: var(--gw-radius-panel);
    box-shadow: var(--gw-shadow-s);
  }

  .panel::before {
    position: absolute;
    inset-block: var(--gw-space-3);
    inset-inline-start: 0;
    width: var(--gw-panel-marker);
    content: "";
    background: var(--gw-color-accent);
  }

  .heading {
    margin: 0 0 var(--gw-space-1);
    font-size: var(--gw-font-size-l);
    font-weight: var(--gw-font-weight-strong);
    color: var(--gw-color-text-strong);
    text-transform: var(--gw-label-transform);
    letter-spacing: var(--gw-label-tracking);
  }

  .primary,
  .secondary {
    margin: 0 0 var(--gw-space-2);
  }

  .secondary {
    font-size: var(--gw-font-size-xs);
    color: var(--gw-color-text-secondary);
  }

  a {
    color: var(--gw-link-color);
    text-decoration-thickness: var(--gw-link-underline);
    text-underline-offset: 0.2em;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gw-space-2);
  }

  .alerts {
    display: grid;
    gap: var(--gw-space-2);
  }

  .rows {
    width: 100%;
    margin: 0;
    font-size: var(--gw-font-size-s);
    border-collapse: collapse;
  }

  .rows td {
    padding: var(--gw-row-padding) var(--gw-space-2);
    border-top: 1px solid var(--gw-color-border-quiet);
  }

  .figure {
    font-family: var(--gw-font-figures);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .rows td:last-child {
    text-align: end;
  }
</style>

<script>
  // Registers the elements the preview uses. Astro bundles this once per page.
  import "../demos/index.ts";
</script>
