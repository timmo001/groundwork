---
/**
 * `<ThemeUpload>`: the "Your own theme" demo on the Themes page, a
 * `gw-theme-upload` around a few components that take the uploaded theme.
 */
---

<gw-theme-upload data-gw-theme="base" data-gw-mode="dark">
  <div class="surface">
    <gw-input label="Hostname" value="workshop"></gw-input>
    <div class="row">
      <gw-chip>Linux</gw-chip>
      <gw-chip tone="accent">Windows</gw-chip>
      <gw-chip tone="success">Passing</gw-chip>
    </div>
    <gw-alert tone="warning" heading="Warning">The token expires in 2 days.</gw-alert>
    <div class="row">
      <gw-button appearance="filled">Plan boot</gw-button>
      <gw-button>Reboot</gw-button>
      <gw-button variant="neutral" appearance="outlined">Cancel</gw-button>
    </div>
  </div>
</gw-theme-upload>

<style>
  .surface {
    display: grid;
    gap: var(--gw-space-4);
    padding: var(--gw-space-5);
    font-family: var(--gw-font-sans);
    color: var(--gw-color-text-primary);
    background: var(--gw-color-surface-default);
    border: 1px solid var(--gw-color-border-normal);
    border-radius: var(--gw-radius-panel);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gw-space-2);
  }
</style>

<script>
  // Only this page solves themes in the browser, so it loads the solver alone.
  import "../demos/index.ts";
  import "../demos/gw-theme-upload.ts";
</script>
