---
/** A GitHub label as GitHub draws it, for the conventions pages. */
interface Props {
  name: string;
  color: string;
}

const { name, color } = Astro.props;

// Black or white text, whichever contrasts more with the label's color, so
// every label reaches WCAG AA rather than following GitHub's cutoff. One of
// the two always clears 4.5:1.
const channel = (offset: number) => {
  const value = Number.parseInt(color.slice(offset, offset + 2), 16) / 255;

  return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
};

const luminance =
  0.2126 * channel(0) + 0.7152 * channel(2) + 0.0722 * channel(4);

const dark = (luminance + 0.05) / 0.05;
const light = 1.05 / (luminance + 0.05);
---

<span
  class="chip"
  style={`background: #${color}; color: ${dark >= light ? "#000000" : "#ffffff"}`}
  >{name}</span
>

<style>
  .chip {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    border: 1px solid #8884;
    border-radius: 999px;
  }
</style>
