---
/**
 * `<LabelSet>`: one label set from `conventions/labels.yml` as a table, with
 * the old names each label renames.
 */
import conventions from "@timmo001/groundwork-conventions/conventions.json";
import LabelChip from "./label-chip.astro";

interface Props {
  set: string;
}

const set = conventions.sets.find((item) => item.id === Astro.props.set);

if (set === undefined) throw new Error(`Unknown label set: ${Astro.props.set}`);

type Label = (typeof set.labels)[number] & { aliases?: string[] };
const labels: Label[] = set.labels;
---

<table>
  <thead>
    <tr>
      <th scope="col">Label</th>
      <th scope="col">Description</th>
      <th scope="col">Renames</th>
    </tr>
  </thead>
  <tbody>
    {
      labels.map((label) => (
        <tr>
          <td>
            <LabelChip color={label.color} name={label.name} />
          </td>
          <td>{label.description}</td>
          <td>
            {(label.aliases ?? []).map((alias, index) => (
              <>
                {index > 0 && ", "}
                <code>{alias}</code>
              </>
            ))}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
