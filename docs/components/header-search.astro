---
/**
 * The header's search box with docs-kit's theme picker, so demos follow the
 * theme the reader picks: Base first with no heading, then the other core
 * themes, then the optional themes by family. It also preloads Base's fonts,
 * the same files theme.css loads, so the first paint already uses them and
 * the text doesn't rewrap when they arrive.
 */
import { themeChoices } from "@timmo001/groundwork-tokens/choices";
import HeaderSearch from "@timmo001/docs-kit/blume/header-search.astro";
import monaSans from "@fontsource-variable/mona-sans/files/mona-sans-latin-wght-normal.woff2?url";
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

const themes = themeChoices({ id: "base" });
---

<link rel="preload" href={monaSans} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
<HeaderSearch {...Astro.props} themes={themes} defaultTheme="base" />
