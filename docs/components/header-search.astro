---
/**
 * The header's search box with docs-kit's theme picker, fed the core themes
 * so demos follow the theme the reader picks.
 */
import tokens from "@timmo001/groundwork-tokens/themes.json";
import HeaderSearch from "@timmo001/docs-kit/blume/header-search.astro";

/** The core themes, for the header's theme picker. */
const themes = tokens.themes
  .filter((theme) => !theme.optional)
  .map((theme) => ({ id: theme.id, name: theme.name }));
---

<HeaderSearch {...Astro.props} themes={themes} defaultTheme="base" />
