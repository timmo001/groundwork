---
/**
 * `<Demo>`: a live example on a component page, in a `gw-demo-frame` with
 * its own theme, mode and tone controls.
 */
interface Props {
  /** The theme the demo renders in. */
  theme?: string;
  /** `row` lines the examples up; `stack` stacks them full width. */
  layout?: "row" | "stack";
  /** Names the demo for tests and links. */
  id?: string;
}

const { theme = "base", layout = "row", id } = Astro.props;
---

<gw-demo-frame
  class="demo"
  data-gw-theme={theme}
  layout={layout}
  id={id === undefined ? undefined : `demo-${id}`}
>
  <slot />
</gw-demo-frame>

<script>
  // Registers the elements the demos use. Astro bundles this once per page.
  import "../demos/index.ts";
</script>

<style>
  .demo {
    display: block;
    margin-block: 1.5rem;
  }

  /* Before the frame's script runs, keep the room its toolbar and stage
     will take, so the page doesn't move when it upgrades */
  .demo:not(:defined) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gw-space-3);
    align-items: center;
    padding: calc(var(--gw-space-6) + var(--gw-space-3) * 2 + 2.5rem + 1px)
      var(--gw-space-5) var(--gw-space-6);
    border: 1px solid var(--gw-color-border-normal);
    border-radius: var(--gw-radius-panel);
  }

  .demo:not(:defined)[layout="stack"] {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
  }
</style>
