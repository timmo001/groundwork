---
interface Props {
  /** The theme the demo renders in. */
  theme?: string;
  /** `row` lines the examples up; `stack` stacks them full width. */
  layout?: "row" | "stack";
  /** Names the demo for tests and links. */
  id?: string;
}

const { theme = "base", layout = "row", id } = Astro.props;
---

<gw-demo-frame
  class="demo"
  data-gw-theme={theme}
  layout={layout}
  id={id === undefined ? undefined : `demo-${id}`}
>
  <slot />
</gw-demo-frame>

<script>
  // Registers the Lit elements the demos use. Astro bundles this once per page.
  import "../demos/index.ts";
</script>

<style>
  .demo {
    display: block;
    margin-block: 1.5rem;
  }
</style>
