---
/** `<ThemeSwatches>`: every color role of a theme, with its value in each mode. */
import tokens from "@timmo001/groundwork-tokens/themes.json";

interface Props {
  theme: string;
}

const theme = tokens.themes.find((item) => item.id === Astro.props.theme);

if (theme === undefined) throw new Error(`Unknown theme: ${Astro.props.theme}`);

const modes = Object.entries(theme.modes);
const roles = Object.keys(modes[0]?.[1] ?? {});
---

<div class="wrap">
  <table class="swatches">
    <thead>
      <tr>
        <th scope="col">Role</th>
        {modes.map(([mode]) => <th scope="col">{mode}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        roles.map((role) => (
          <tr>
            <th scope="row">
              <code>--gw-color-{role}</code>
            </th>
            {modes.map(([, colors]) => {
              const hex = (colors as Record<string, string>)[role] ?? "";

              return (
                <td>
                  <span class="swatch" style={`background: ${hex}`} />
                  <code>{hex}</code>
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .wrap {
    overflow-x: auto;
  }

  .swatches {
    font-size: 0.8125rem;
  }

  .swatches th[scope="row"] {
    font-weight: 400;
    white-space: nowrap;
  }

  .swatches td {
    white-space: nowrap;
  }

  .swatch {
    display: inline-block;
    width: 1.25rem;
    height: 1.25rem;
    margin-inline-end: 0.5rem;
    vertical-align: middle;
    background-image:
      linear-gradient(45deg, #8884 25%, transparent 25%),
      linear-gradient(-45deg, #8884 25%, transparent 25%);
    border: 1px solid #8886;
    border-radius: 4px;
  }
</style>
