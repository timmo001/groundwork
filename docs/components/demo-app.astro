---
/**
 * `<DemoApp>`: the web demo of Groundwork's demo app, a `gw-demo-app` in a
 * demo frame with its theme and mode pickers. Used on the Demo page.
 */
import "@timmo001/groundwork-demo/web.css";
import Demo from "./demo.astro";
---

<Demo id="app" layout="stack">
  <gw-demo-app></gw-demo-app>
</Demo>

<script>
  // Only the Demo page runs the demo app, so it loads it alone.
  import "@timmo001/groundwork-demo/web";
</script>
