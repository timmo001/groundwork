{
  "config": {
    "default": true,
    "MD013": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "dist/**",
    "docs/dist/**",
    "docs/.blume/**",
    "docs/.blume-verify/**",
    "docs/test-results/**",
    "docs/playwright-report/**",
    ".agents/skills/**",
  ],
}
